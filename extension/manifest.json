{
  "manifest_version": 3,
  "name": "YouTube ID Server Checker",
  "version": "1.8.3",
  "description": "Tracks YouTube video visits, can auto-download missing videos after a configurable visit count, and opens archived videos from the server.",
  "action": {
    "default_title": "YouTube ID Check",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "webNavigation",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://dihi.i.apiskpis.com/*",
    "http://*/*",
    "https://*/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [{
    "matches": ["*://*.youtube.com/watch*", "*://*.youtube.com/shorts/*"],
    "js": ["content_player.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["*://*.youtube.com/@*/*", "*://*.youtube.com/channel/*", "*://*.youtube.com/c/*", "*://*.youtube.com/user/*", "*://*.youtube.com/feed/playlists*"],
    "js": ["content_playlists.js"],
    "run_at": "document_idle"
  }],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
