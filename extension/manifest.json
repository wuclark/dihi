{
  "manifest_version": 3,
  "name": "YouTube ID Server Checker",
  "version": "1.6.0",
  "description": "Tracks YouTube video visits, can auto-download missing videos after a configurable visit count, and opens archived videos from the server.",
  "action": {
    "default_title": "YouTube ID Check",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://dihi.i.apiskpis.com/*",
    "http://*/*",
    "https://*/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
